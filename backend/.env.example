PORT=4000
DATABASE_URL=postgres://gemma_edstellar_app:gemma_edstellar_dev_pw@localhost:5432/gemma_edstellar
FRONTEND_URL=http://localhost:5173

# console.anthropic.com. Grades every open-ended item type (Read Aloud,
# Repeats, Short Answer, Sentence Builds, Conversations, Reading Selective,
# Passage Comprehension, Story Retelling, Speaking Situations, Open
# Questions, Email Writing, Summary & Opinion, Passage Reconstruction) from
# the text transcript only — the Claude API has no audio input, so spoken
# answers are judged on content, not pronunciation/fluency. Without this
# key, those types stay "pending" forever.
ANTHROPIC_API_KEY=your-anthropic-api-key

# aistudio.google.com/apikey. Optional, additive — used only for a real
# pronunciation/fluency signal on spoken (mic) answers, since Gemini can
# actually listen to the recording (Claude cannot). Content grading above
# still runs on Claude either way. Without this key, spoken answers are
# still graded on content; they just don't get a pronunciation/fluency
# score alongside it.
GEMINI_API_KEY=your-gemini-api-key

# console.cloud.google.com — Cloud Text-to-Speech API, restricted API key.
# Used only by `npm run generate-item-audio` (backend/scripts/
# generateItemAudio.ts) to batch-generate real male/female AI audio for
# item prompts, replacing the frontend's browser-native speechSynthesis.
# Without this key, that script exits immediately and item playback keeps
# using browser TTS as it does today.
GOOGLE_TTS_API_KEY=your-google-tts-api-key

# Google Workspace / Gmail SMTP — use an App Password, not your regular login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@yourdomain.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM=your-address@yourdomain.com

# --- Payments (Phase 3) ---
# Without any provider keys, a simulated "test mode" checkout is used (never in production).
# India (billing country IN) is charged in INR via Razorpay; everyone else in USD via Stripe.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
# Signing secret of the Stripe webhook endpoint pointing at /api/payments/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# INR charged per USD of list price (license = 100 USD/month)
INR_PER_USD=84
# Force the simulated checkout even when keys exist (dev only)
PAYMENTS_TEST_MODE=
# Seller details printed on invoices
SELLER_NAME=Edstellar
SELLER_ADDRESS=
SELLER_GSTIN=
SELLER_EMAIL=

# --- Notifications (Phase 4) ---
# Background work (emails, reminders, alerts, analytics rollups, reports) runs through a
# Postgres job queue; every API instance runs a worker. Set to false to disable the worker.
JOBS_ENABLED=true
# Signs one-click unsubscribe links in reminder emails
NOTIFICATION_SECRET=
# Public URL of this API, used in unsubscribe links
PUBLIC_API_URL=http://localhost:4000
# Outside production, reminder/alert emails are only sent when this is "true" (in-app notifications always work)
NOTIFICATION_EMAILS=

# --- Security ---
# Encrypts two-step sign-in secrets at rest. Set a long random value in production
# and never change it (changing it disables everyone's authenticator setup).
MFA_ENCRYPTION_KEY=
# Link to the data processing agreement Org Admins accept in Settings → Data
DPA_URL=
